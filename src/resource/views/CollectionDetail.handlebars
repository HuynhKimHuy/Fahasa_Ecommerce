<section class="collection-detail">
  <div class="container">
    {{#if notFound}}
    <div class="collection-detail__empty">
      <h1>Không tìm thấy sản phẩm</h1>
      <p>Không có sách nào có slug <strong>{{slug}}</strong>.</p>
      <a href="/collection" class="btn btn--primary">Quay lại bộ sưu tập</a>
    </div>
    {{else}}

    {{!-- render ra sản phảm --}}
    <div class="collection-detail__inner">
      {{!-- img --}}
      <div class="collection-detail__media">
        <img src="{{book.coverImage}}" alt="{{book.title}}">
        <div class="collection-detail__btn">
          <div class="collection-detail__cta">
            {{!-- số lượng bán  --}}
            {{!-- <div class="collection-detail__sold">
              Đã bán: <strong>{{book.sold}}</strong>
            </div> --}}
            <form class="collection-detail__cart" action="/cart/add/{{book._id}}" method="post">
              <button type="submit" name="action" value="add" class="collection-detail__cart-btn collection-detail__cart-btn--outline">
                <i class="fa-solid fa-cart-shopping"></i>
                Thêm vào giỏ hàng
              </button>
              <button type="submit" name="action" value="buy" class="collection-detail__cart-btn collection-detail__cart-btn--solid">
                Mua ngay
              </button>
            </form>
            {{!-- <a href="/collection" class="btn btn--ghost">Xem thêm bộ sưu tập</a> --}}
          </div>
        </div>
      </div>

      <div class="collection-detail__info">
        <p class="collection-detail__tag">{{book.category}}</p>
        <h1>{{book.title}}</h1>
        <p class="collection-detail__author">Tác giả: {{book.author}}</p>
        <p class="collection-detail__description">{{book.description}}</p>
        <div class="collection-detail__price-row">
          <span class="collection-detail__price">{{formatPrice book.newPrice}}</span>
          {{#if book.discountPercent}}
          <span class="collection-detail__discount">-{{book.discountPercent}}%</span>
          <span class="collection-detail__old-price">{{formatPrice book.oldPrice}}</span>
          {{/if}}
        </div>
        <p class="collection-detail__long">{{book.longDescription}}</p>
        <ul class="collection-detail__meta">
          <li>Nhà xuất bản: {{book.publisher}}</li>
          <li>Năm xuất bản: {{book.publishYear}}</li>
          <li>Trang: {{book.size}}</li>
          <li>Loại bìa: {{book.coverType}}</li>
        </ul>

      </div>
    </div>
    {{/if}}
  </div>
</section>
