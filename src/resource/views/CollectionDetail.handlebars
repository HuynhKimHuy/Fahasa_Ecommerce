<section class="collection-detail">
  <div class="container">
    {{#if notFound}}
      <div class="collection-detail__empty">
        <h1>Không tìm thấy sản phẩm</h1>
        <p>Không có sách nào có slug <strong>{{slug}}</strong>.</p>
        <a href="/collection" class="btn btn--primary">Quay lại bộ sưu tập</a>
      </div>
    {{else}}
      <div class="breadcrumb">
        <a href="/">Trang chủ</a>
        <span>/</span>
        <a href="/collection">Bộ sưu tập</a>
        <span>/</span>
        <span>{{book.title}}</span>
      </div>

      <div class="collection-detail__inner">
        <div class="collection-detail__left">
          <div class="collection-detail__media-card">
            <img src="{{book.coverImage}}" alt="{{book.title}}">
            
          </div>

          <div class="collection-detail__policies">
            <h3>Chính sách ưu đãi Fahasa</h3>
            <ul>
              <li><i class="fa-solid fa-check"></i> Thời gian giao hàng nhanh ở TP.HCM</li>
              <li><i class="fa-solid fa-check"></i> Giao toàn quốc, đổi trả khi có lỗi</li>
              <li><i class="fa-solid fa-check"></i> Hỗ trợ đổi trả 7 ngày</li>
            </ul>
          </div>
        </div>

        <div class="collection-detail__right">
          <header class="collection-detail__header">
            <h1>{{book.title}}</h1>
            <p class="collection-detail__meta-line">
              <span>Tác giả: <strong>{{book.author}}</strong></span>
              {{#if book.publisher}}
                <span>Nhà XB: <strong>{{book.publisher}}</strong></span>
              {{/if}}
            </p>
            <p class="collection-detail__category">
              Danh mục:
              <a href="/collection?category={{urlEncode book.category}}">{{book.category}}</a>
            </p>
            <div class="collection-detail__rating">
              {{#if book.hasRating}}
                <div class="rating-pill">
                  <i class="fa-solid fa-star"></i>
                  <strong>{{book.ratingLabel}}</strong>
                  <span>/5</span>
                </div>
                <span class="rating-count">({{book.ratingCount}} đánh giá)</span>
              {{else}}
                <span class="rating-empty">Chưa có đánh giá</span>
              {{/if}}
            </div>
          </header>

          <div class="collection-detail__price-card">
            <div class="collection-detail__price-main">
              <span class="price">{{formatPrice book.newPrice}}</span>
              {{#if book.discountPercent}}
                <span class="discount">-{{book.discountPercent}}%</span>
              {{/if}}
            </div>
            {{#if book.oldPrice}}
              <div class="collection-detail__price-old">{{formatPrice book.oldPrice}}</div>
            {{/if}}
            <div class="collection-detail__stock">
              {{#if book.stock}}
                Còn lại: <strong>{{book.stock}}</strong> | Đã bán: <strong>{{book.sold}}</strong>
              {{else}}
                Hết hàng
              {{/if}}
            </div>
          </div>

          <div class="collection-detail__actions">
            <form class="collection-detail__cart" action="/cart/add/{{book._id}}" method="post">
              <label class="quantity">
                Số lượng
                <input type="number" name="quantity" min="1" value="1">
              </label>
              <div class="action-buttons">
                <button type="submit" name="action" value="add" class="btn btn--outline">
                  <i class="fa-solid fa-cart-shopping"></i>
                  Thêm vào giỏ hàng
                </button>
                <button type="submit" name="action" value="buy" class="btn btn--primary">
                  Mua ngay
                </button>
              </div>
            </form>
          </div>

          <div class="collection-detail__shipping">
            <h3>Thông tin vận chuyển</h3>
            <ul>
              <li>Giao hàng nhanh nội thành</li>
              <li>Đồng kiểm khi nhận</li>
              <li>Miễn phí đơn từ 300.000đ (tuỳ khu vực)</li>
            </ul>
          </div>

          <div class="collection-detail__specs">
            <h3>Thông tin chi tiết</h3>
            <div class="specs-grid">
              <div><span>Mã hàng</span><strong>{{book._id}}</strong></div>
              <div><span>Thể loại</span><strong>{{book.category}}</strong></div>
              <div><span>Năm XB</span><strong>{{book.publishYear}}</strong></div>
              <div><span>Tác giả</span><strong>{{book.author}}</strong></div>
              <div><span>Loại bìa</span><strong>{{book.coverType}}</strong></div>
              <div><span>Kích thước</span><strong>{{book.size}}</strong></div>
            </div>
          </div>

          <div class="collection-detail__description">
            <h3>Mô tả sản phẩm</h3>
            <div class="description__content">
              {{#if book.longDescription}}
                {{{book.longDescription}}}
              {{else}}
                <p>{{book.description}}</p>
              {{/if}}
            </div>
          </div>

          <section class="collection-detail__reviews">
            <header class="reviews__header">
              <div>
                <p class="reviews__eyebrow">Đánh giá & nhận xét</p>
                <h3>Trải nghiệm của độc giả</h3>
                <p class="reviews__subtitle">Chỉ nhận đánh giá 4 hoặc 5 sao để đảm bảo chất lượng nội dung.</p>
              </div>
              <div class="reviews__score">
                {{#if book.hasRating}}
                  <div class="reviews__score-main">
                    <span class="reviews__score-number">{{book.ratingLabel}}</span>
                    <span class="reviews__score-total">/5</span>
                  </div>
                  <div class="reviews__score-stars" aria-label="Điểm trung bình">
                    <div class="rating-bar">
                      <div class="rating-bar__fill" style="width: {{book.ratingFill}}%"></div>
                    </div>
                  </div>
                  <p class="reviews__score-count">{{book.ratingCount}} đánh giá</p>
                {{else}}
                  <p class="reviews__score-empty">Chưa có đánh giá</p>
                {{/if}}
              </div>
            </header>

            {{#if flash.message}}
              <div class="reviews__flash reviews__flash--{{flash.status}}">
                {{flash.message}}
              </div>
            {{/if}}

            <div class="reviews__grid">
              <form class="review-form" action="/collection/{{book._id}}/reviews" method="post">
                <h4>Chia sẻ trải nghiệm của bạn</h4>
                <p>Chúng tôi chỉ hiển thị đánh giá 4 hoặc 5 sao để giữ chất lượng nội dung.</p>
                <div class="review-form__rating">
                  <label class="star-option">
                    <input type="radio" name="rating" value="5" required>
                    <span>
                      <i class="fa-solid fa-star"></i>
                      5 sao
                    </span>
                  </label>
                  <label class="star-option">
                    <input type="radio" name="rating" value="4" required>
                    <span>
                      <i class="fa-solid fa-star"></i>
                      4 sao
                    </span>
                  </label>
                </div>
                <label class="review-form__field">
                  <span>Họ tên</span>
                  <input type="text" name="name" placeholder="Tên hiển thị" maxlength="120">
                </label>
                <label class="review-form__field">
                  <span>Nội dung đánh giá</span>
                  <textarea name="comment" rows="4" maxlength="2000" placeholder="Chia sẻ ngắn gọn cảm nhận của bạn (tuỳ chọn)"></textarea>
                </label>
                <button type="submit" class="btn btn--primary review-form__submit">Gửi đánh giá</button>
              </form>

              <div class="review-list">
                {{#if reviews.length}}
                  {{#each reviews}}
                    <article class="review-card">
                      <div class="review-card__top">
                        <div class="review-card__avatar">{{this.initial}}</div>
                        <div>
                          <p class="review-card__name">{{this.displayName}}</p>
                          <p class="review-card__meta">{{this.createdAtLabel}}</p>
                        </div>
                        <div class="review-card__rating">
                          <i class="fa-solid fa-star"></i>
                          <span>{{this.rating}}</span>
                        </div>
                      </div>
                      {{#if this.comment}}
                        <p class="review-card__comment">{{this.comment}}</p>
                      {{/if}}
                    </article>
                  {{/each}}
                {{else}}
                  <p class="review-list__empty">Chưa có nhận xét nào. Hãy là người đầu tiên đánh giá!</p>
                {{/if}}
              </div>
            </div>
          </section>
        </div>
      </div>
    {{/if}}
  </div>
</section>
