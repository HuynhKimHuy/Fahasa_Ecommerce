<section class="collections">
  <div class="container">
    <div class="collections__header">
      <h1>
        {{#if searchQuery}}
          Kết quả cho "{{searchQuery}}"
        {{else}}
          Bộ sưu tập nổi bật
        {{/if}}
      </h1>
      <p class="collections__subtitle">
        {{#if searchQuery}}
          Tìm thấy {{books.length}} đầu sách phù hợp.
        {{else}}
          Tổng {{books.length}} đầu sách đang được bán chạy nhất.
        {{/if}}
      </p>
    </div>
    
    {{#if books.length}}
    <div class="collections__grid">
      {{#each books}}
      <article class="collections__card">
        <a class="collections__card-link" href="/collection/{{#if this._id}}{{this._id}}{{else}}{{this.slug}}{{/if}}">
          <div class="collections__card-thumb">
            <img src="{{this.coverImage}}" alt="{{this.title}}" />
          </div>
          <div class="collections__card-body">
            <h2 class="collections__card-title">{{this.title}}</h2>
            <p class="collections__card-author">{{this.author}}</p>
            <div class="collections__card-rating">
              {{#if this.hasRating}}
                <i class="fa-solid fa-star"></i>
                <span>{{this.ratingLabel}}</span>
                <span class="collections__card-rating-count">({{this.ratingCount}} đánh giá)</span>
              {{else}}
                <span class="collections__card-rating-empty">Chưa có đánh giá</span>
              {{/if}}
            </div>
            <div class="collections__card-price-row">
              <span class="collections__card-price">{{formatPrice this.newPrice}}</span>
              {{#if this.discountPercent}}
              <span class="collections__card-discount">-{{this.discountPercent}}%</span>
              {{/if}}
            </div>
          </div>
        </a>
      </article>
      {{/each}}
    </div>
    {{else}}
    <p class="collections__empty">Hiện chưa có sản phẩm nào trong bộ sưu tập.</p>
    {{/if}}
  </div>
</section>
