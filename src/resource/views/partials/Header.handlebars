<header class="header">
  <div class="sale_top_nav">
    <img src="/img/sale_on_top.png" alt="">
  </div>
  <div class="container">
    <nav class="navbar">
      <div class="navbar__left">
        <button type="button" class="navbar__toggle" aria-label="Mở menu" data-drawer-open>
          <span></span>
          <span></span>
          <span></span>
        </button>
        {{!-- navlogo --}}
        <a href="/" class="nav_logo">
          <img src="/img/image.png" alt="">
        </a>
        <div class="nav_menu-wrapper" data-nav-menu>
          <button type="button" class="nav_menu" aria-label="Mở danh mục" data-nav-toggle>
            <i class="fa-solid fa-list"></i>
            <span>Danh mục</span>
          </button>
          <div class="nav_dropdown" data-nav-dropdown>
            {{#if categories.length}}
              <div class="nav_dropdown__list">
                {{#each categories}}
                  <a class="nav_dropdown__item" href="/collection?category={{urlEncode this.name}}">
                    <span class="nav_dropdown__dot"></span>
                    <span class="nav_dropdown__label">{{this.name}}</span>
                  </a>
                {{/each}}
                <a class="nav_dropdown__item nav_dropdown__item--all" href="/collection">
                  <span class="nav_dropdown__label">Xem tất cả</span>
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            {{else}}
              <p class="nav_dropdown__empty">Chưa có danh mục.</p>
            {{/if}}
          </div>
        </div>
      </div>

      <form action="/search" class="header-search navbar__search">
        <input type="text" name="q" placeholder="Bạn muốn mua gì " class="header-search__input" value="{{searchQuery}}" />
        <button type="submit" class="header-search__btn">
          <i class="fa-solid fa-magnifying-glass"></i>
        </button>
      </form>

      <div class="nav-actions">
        <a href="#" class="nav-action">
          <i class="fa-regular fa-bell"></i>
          <span>Thông báo</span>
        </a>

        <a href="/cart" class="nav-action">
          <i class="fa-solid fa-bag-shopping"></i>
          <span>Giỏ Hàng</span>
        </a>

        {{#if currentUser}}
          <div class="nav-action nav-action--user">
            <i class="fa-solid fa-user-check"></i>
            <span>{{currentUser.fullName}}</span>
          </div>
          <a href="/auth/logout" class="nav-action nav-action--logout">
            <i class="fa-solid fa-arrow-right-from-bracket"></i>
            <span>Đăng xuất</span>
          </a>
          {{#if (isAdmin currentUser.role)}}
            <a href="/admin/books" class="nav-action nav-action--admin">
              <i class="fa-solid fa-shield"></i>
              <span>Admin</span>
            </a>
          {{/if}}
        {{else}}
          <a href="/auth/login" class="nav-action">
            <i class="fa-solid fa-user"></i>
            <span>Đăng Nhập</span>
          </a>
          <a href="/auth/register" class="nav-action">
            <i class="fa-solid fa-user-plus"></i>
            <span>Đăng Ký</span>
          </a>
        {{/if}}
      </div>

    </nav>
  </div>

  <div class="mobile-drawer__overlay" data-drawer-overlay></div>
  <aside class="mobile-drawer" data-drawer>
    <div class="mobile-drawer__header">
      <div class="mobile-drawer__brand">
        <img src="/img/image.png" alt="Fahasa Logo">
        <div class="mobile-drawer__brand-text">
          <span>Fahasa</span>
          <small>Khám phá sách</small>
        </div>
      </div>
      <button type="button" class="mobile-drawer__close" aria-label="Đóng menu" data-drawer-close>
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <div class="mobile-drawer__body">
      <form action="/search" class="mobile-search">
        <input type="text" name="q" placeholder="Bạn muốn mua gì" value="{{searchQuery}}" />
        <button type="submit" aria-label="Tìm kiếm">
          <i class="fa-solid fa-magnifying-glass"></i>
        </button>
      </form>
      <div class="mobile-accordion" data-accordion>
        <button class="mobile-accordion__trigger" type="button" data-accordion-toggle>
          <span>Danh mục</span>
          <i class="fa-solid fa-chevron-down"></i>
        </button>
        <div class="mobile-accordion__panel" data-accordion-panel>
          {{#if categories.length}}
            <div class="mobile-accordion__list">
              {{#each categories}}
                <a class="mobile-accordion__link" href="/collection?category={{urlEncode this.name}}">
                  <span class="mobile-accordion__dot"></span>
                  <span>{{this.name}}</span>
                </a>
              {{/each}}
              <a class="mobile-accordion__link mobile-accordion__link--all" href="/collection">Xem tất cả</a>
            </div>
          {{else}}
            <p class="mobile-accordion__empty">Chưa có danh mục.</p>
          {{/if}}
        </div>
      </div>

      <div class="mobile-accordion" data-accordion>
        <button class="mobile-accordion__trigger" type="button" data-accordion-toggle>
          <span>Tài khoản & tiện ích</span>
          <i class="fa-solid fa-chevron-down"></i>
        </button>
        <div class="mobile-accordion__panel" data-accordion-panel>
          <div class="mobile-accordion__list">
            <a class="mobile-accordion__link" href="#">
              <i class="fa-regular fa-bell"></i>
              <span>Thông báo</span>
            </a>
            <a class="mobile-accordion__link" href="/cart">
              <i class="fa-solid fa-bag-shopping"></i>
              <span>Giỏ hàng</span>
            </a>

            {{#if currentUser}}
              <div class="mobile-accordion__user">
                <i class="fa-solid fa-user-check"></i>
                <div>
                  <p>Xin chào</p>
                  <strong>{{currentUser.fullName}}</strong>
                </div>
              </div>
              <a class="mobile-accordion__link" href="/auth/logout">
                <i class="fa-solid fa-arrow-right-from-bracket"></i>
                <span>Đăng xuất</span>
              </a>
              {{#if (isAdmin currentUser.role)}}
                <a class="mobile-accordion__link" href="/admin/books">
                  <i class="fa-solid fa-shield"></i>
                  <span>Admin</span>
                </a>
              {{/if}}
            {{else}}
              <a class="mobile-accordion__link" href="/auth/login">
                <i class="fa-solid fa-user"></i>
                <span>Đăng nhập</span>
              </a>
              <a class="mobile-accordion__link" href="/auth/register">
                <i class="fa-solid fa-user-plus"></i>
                <span>Đăng ký</span>
              </a>
            {{/if}}
          </div>
        </div>
      </div>
    </div>
  </aside>
</header>

{{!-- end header --}}
