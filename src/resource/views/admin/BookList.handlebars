<div class="admin-page">
  <header class="admin-hero">
    <div>
      <p class="admin-hero__eyebrow">Quản trị hệ thống</p>
      <h1>Quản lý sách</h1>
      <p class="admin-hero__description">
        Xem toàn bộ danh mục, thay đổi trạng thái, và duy trì thông tin hàng tồn kho ngay lập tức.
      </p>
    </div>
    <div class="admin-hero__actions">
      <button class="admin-sidebar-toggle" type="button" data-admin-sidebar-open>
        <span class="admin-sidebar-toggle__bars" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
        <span class="admin-sidebar-toggle__label">Menu</span>
      </button>
      <a class="btn btn--primary" href="/admin/books/new">Tạo sách mới</a>
    </div>
  </header>

  <div class="admin-layout" data-admin-layout>
    <aside class="admin-sidebar admin-sidebar--compact" data-sidebar-accordion data-admin-sidebar>
      <button class="admin-sidebar__close" type="button" data-admin-sidebar-close>
        <i class="fa-solid fa-xmark"></i>
      </button>
      <div class="admin-sidebar__drag-handle" data-admin-sidebar-drag></div>
      <div class="admin-sidebar__top">
        <button
          type="button"
          class="admin-sidebar__chip {{#if (eq navActive "books")}}is-active{{/if}}"
          data-accordion-open="books"
        >
          <i class="fa-solid fa-book" aria-hidden="true"></i> Books
        </button>
        <button
          type="button"
          class="admin-sidebar__chip {{#if (eq navActive "orders")}}is-active{{/if}}"
          data-accordion-open="orders"
        >
          <i class="fa-solid fa-receipt" aria-hidden="true"></i> Orders
        </button>
        <button
          type="button"
          class="admin-sidebar__chip {{#if (eq navActive "users")}}is-active{{/if}}"
          data-accordion-open="users"
        >
          <i class="fa-solid fa-users" aria-hidden="true"></i> Users
        </button>
      </div>

      <div
        class="admin-sidebar__section {{#if (eq navActive "books")}}is-open{{/if}}"
        data-accordion-section="books"
      >
        <button type="button" class="admin-sidebar__section-header" data-accordion-toggle>
          <span>Books Management</span>
          <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
        </button>
        <div class="admin-sidebar__section-body">
          <a class="admin-sidebar__link {{#if (eq navActive "books")}}is-active{{/if}}" href="/admin/books">
            <span class="admin-sidebar__link-left">
              <i class="fa-solid fa-book admin-sidebar__icon" aria-hidden="true"></i>
              <span>Tất cả sách</span>
            </span>
            <span class="admin-sidebar__count">{{stats.totalBooks}}</span>
          </a>
          <a class="admin-sidebar__link" href="/admin/books/new">
            <span class="admin-sidebar__link-left">
              <i class="fa-solid fa-plus admin-sidebar__icon" aria-hidden="true"></i>
              <span>Thêm sách mới</span>
            </span>
          </a>
          <p class="admin-sidebar__subheading">Danh mục</p>
          {{#each categories}}
            <a
              class="admin-sidebar__link {{#if (eq ../filters.category this.value)}}is-active{{/if}}"
              href="/admin/books?category={{urlEncode this.value}}"
            >
              <span class="admin-sidebar__link-left">
                <i class="fa-solid fa-layer-group admin-sidebar__icon" aria-hidden="true"></i>
                <span>{{this.name}}</span>
              </span>
              <span class="admin-sidebar__count">{{this.total}}</span>
            </a>
          {{/each}}
          <p class="admin-sidebar__subheading">Trạng thái</p>
          {{#each statusOptions}}
            <a
              class="admin-sidebar__link {{#if (eq ../filters.status this.value)}}is-active{{/if}}"
              href="/admin/books?status={{this.value}}"
            >
              <span class="admin-sidebar__link-left">
                <i class="fa-solid fa-filter admin-sidebar__icon" aria-hidden="true"></i>
                <span>{{this.label}}</span>
              </span>
            </a>
          {{/each}}
        </div>
      </div>

      <div
        class="admin-sidebar__section {{#if (eq navActive "orders")}}is-open{{/if}}"
        data-accordion-section="orders"
      >
        <button type="button" class="admin-sidebar__section-header" data-accordion-toggle>
          <span>Orders Management</span>
          <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
        </button>
        <div class="admin-sidebar__section-body">
          <a class="admin-sidebar__link" href="/admin/orders">
            <span class="admin-sidebar__link-left">
              <i class="fa-solid fa-receipt admin-sidebar__icon" aria-hidden="true"></i>
              <span>Danh sách đơn</span>
            </span>
            <span class="admin-sidebar__count">{{orderStats.total}}</span>
          </a>
          <a class="admin-sidebar__link" href="/admin/orders">
            <span class="admin-sidebar__link-left">
              <i class="fa-solid fa-bell admin-sidebar__icon" aria-hidden="true"></i>
              <span>Đơn mới</span>
            </span>
            <span class="admin-sidebar__count">{{orderStats.newOrders}}</span>
          </a>
          <a class="admin-sidebar__link" href="/admin/orders">
            <span class="admin-sidebar__link-left">
              <i class="fa-solid fa-truck-fast admin-sidebar__icon" aria-hidden="true"></i>
              <span>Đang giao</span>
            </span>
            <span class="admin-sidebar__count">{{orderStats.shipping}}</span>
          </a>
          <a class="admin-sidebar__link" href="/admin/orders">
            <span class="admin-sidebar__link-left">
              <i class="fa-solid fa-check admin-sidebar__icon" aria-hidden="true"></i>
              <span>Đã giao</span>
            </span>
            <span class="admin-sidebar__count">{{orderStats.completed}}</span>
          </a>
        </div>
      </div>

      <div
        class="admin-sidebar__section {{#if (eq navActive "users")}}is-open{{/if}}"
        data-accordion-section="users"
      >
        <button type="button" class="admin-sidebar__section-header" data-accordion-toggle>
          <span>Users Management</span>
          <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
        </button>
        <div class="admin-sidebar__section-body">
          <a class="admin-sidebar__link" href="/admin/users">
            <span class="admin-sidebar__link-left">
              <i class="fa-solid fa-users admin-sidebar__icon" aria-hidden="true"></i>
              <span>Danh sách người dùng</span>
            </span>
          </a>
        </div>
      </div>
    </aside>

    <div class="admin-main">
      <section class="admin-filters-card admin-filters-card--compact">
        <form class="admin-filters admin-filters--compact" action="/admin/books" method="get">
          <label class="admin-filters__field">
            <span>Tìm kiếm</span>
            <input type="text" name="q" value="{{filters.q}}" placeholder="Tên sách, tác giả, slug..." />
          </label>
          <label class="admin-filters__field">
            <span>Danh mục</span>
            <select name="category">
              <option value="all">Tất cả</option>
              {{#each categories}}
                <option value="{{this.value}}" {{#if (eq ../filters.category this.value)}}selected{{/if}}>
                  {{this.name}}
                </option>
              {{/each}}
            </select>
          </label>
          <label class="admin-filters__field admin-filters__field--inline">
            <span>Trạng thái</span>
            <select name="status">
              {{#each statusOptions}}
                <option value="{{this.value}}" {{#if (eq ../filters.status this.value)}}selected{{/if}}>
                  {{this.label}}
                </option>
              {{/each}}
            </select>
          </label>
          <div class="admin-filters__actions">
            <button type="submit" class="btn btn--primary">Lọc</button>
            <a href="/admin/books" class="btn btn--text">Clear</a>
          </div>
        </form>
      </section>

      <section class="admin-summary-grid">
        <article class="summary-card">
          <p>Tổng số sách</p>
          <strong>{{stats.totalBooks}}</strong>
        </article>
        <article class="summary-card">
          <p>Tổng tồn kho</p>
          <strong>{{stats.totalStock}}</strong>
        </article>
        <article class="summary-card">
          <p>Đang hiển thị</p>
          <strong>{{stats.activeCount}}</strong>
        </article>
        <article class="summary-card">
          <p>Flash sale</p>
          <strong>{{stats.flashSaleCount}}</strong>
        </article>
      </section>

      {{!-- <section class="admin-orders-panel">
        <div class="admin-orders-panel__header">
          <div>
            <p class="admin-hero__eyebrow">Quản lý đơn hàng</p>
            <h2>Đơn đặt sách</h2>
            <p class="admin-hero__description">Xử lý nhanh đơn mới và trạng thái giao hàng ngay tại trang sách.</p>
          </div>
          <div class="admin-orders-panel__meta">
            <span class="admin-order-meta">Cập nhật lúc {{lastOrderUpdatedLabel}}</span>
            <a class="btn btn--outline" href="/admin/orders">Xem tất cả</a>
          </div>
        </div>

        <div class="admin-orders-panel__stats">
          <div class="admin-orders-panel__stat">
            <p>Đơn mới</p>
            <strong>{{orderStats.newOrders}}</strong>
          </div>
          <div class="admin-orders-panel__stat">
            <p>Đang giao</p>
            <strong>{{orderStats.shipping}}</strong>
          </div>
          <div class="admin-orders-panel__stat">
            <p>Đã giao</p>
            <strong>{{orderStats.completed}}</strong>
          </div>
        </div>

        <div class="admin-order-list">
          {{#if orders.length}}
            {{#each orders}}
              <article class="admin-order-card">
                <header class="admin-order-card__header">
                  <div>
                    <p class="admin-order-id">Mã đơn: {{this._id}}</p>
                    <p class="admin-order-date">Đặt lúc {{this.createdAtLabel}}</p>
                  </div>
                  <div class="admin-order-card__badges">
                    <span class="badge badge--{{this.statusTone}}">{{this.statusLabel}}</span>
                    <span class="badge badge--{{this.deliveryTone}}">{{this.deliveryLabel}}</span>
                    <span class="badge badge--muted">{{this.paymentMethodLabel}}</span>
                  </div>
                </header>

                <div class="admin-order-grid">
