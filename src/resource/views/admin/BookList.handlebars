                      <p class="admin-order-meta">Ghi chú: {{this.note}}</p>
                    {{/if}}
                  </div>
                  <div class="admin-order-block admin-order-total">
                    <p class="admin-order-label">Tổng đơn</p>
                    <p class="admin-order-price">{{formatPrice this.totalPrice}}</p>
                    <p class="admin-order-meta">{{this.totalQty}} sản phẩm</p>
                  </div>
                </div>

                <div class="admin-order-actions">
                  <form class="admin-order-status" action="/admin/orders/{{this._id}}/status" method="post">
                    <label for="status-{{this._id}}" class="admin-order-label">Trạng thái</label>
                    <div class="admin-order-status__controls">
                      <select name="status" id="status-{{this._id}}">
                        <option value="pending" {{#if (eq this.status "pending")}}selected{{/if}}>Chờ xử lý</option>
