<div class="admin-page">
  <header class="admin-hero">
    <div>
      <p class="admin-hero__eyebrow">Quản trị hệ thống</p>
      <h1>{{formTitle}}</h1>
      <p class="admin-hero__description">
        Tạo hoặc chỉnh sửa tài khoản người dùng, phân quyền và trạng thái hoạt động.
      </p>
    </div>
  </header>

  <div class="admin-layout">
    <aside class="admin-sidebar admin-sidebar--compact" data-sidebar-accordion data-admin-sidebar>
      <button class="admin-sidebar__close" type="button" data-admin-sidebar-close>
        <i class="fa-solid fa-xmark"></i>
      </button>
      <div class="admin-sidebar__drag-handle" data-admin-sidebar-drag></div>
      <div class="admin-sidebar__top">
        <button
          type="button"
          class="admin-sidebar__chip {{#if (eq navActive "books")}}is-active{{/if}}"
          data-accordion-open="books"
        >
          <i class="fa-solid fa-book" aria-hidden="true"></i> Books
        </button>
        <button
          type="button"
          class="admin-sidebar__chip {{#if (eq navActive "orders")}}is-active{{/if}}"
          data-accordion-open="orders"
        >
          <i class="fa-solid fa-receipt" aria-hidden="true"></i> Orders
        </button>
        <button
          type="button"
          class="admin-sidebar__chip {{#if (eq navActive "users")}}is-active{{/if}}"
          data-accordion-open="users"
        >
          <i class="fa-solid fa-users" aria-hidden="true"></i> Users
        </button>
      </div>

      <div
        class="admin-sidebar__section {{#if (eq navActive "books")}}is-open{{/if}}"
        data-accordion-section="books"
      >
        <button type="button" class="admin-sidebar__section-header" data-accordion-toggle>
          <span>Books Management</span>
          <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
        </button>
        <div class="admin-sidebar__section-body">
          <a class="admin-sidebar__link" href="/admin/books">
            <span class="admin-sidebar__link-left">
              <i class="fa-solid fa-book admin-sidebar__icon" aria-hidden="true"></i>
              <span>Tất cả sách</span>
            </span>
          </a>
          <a class="admin-sidebar__link" href="/admin/books/new">
            <span class="admin-sidebar__link-left">
              <i class="fa-solid fa-plus admin-sidebar__icon" aria-hidden="true"></i>
              <span>Thêm sách mới</span>
            </span>
          </a>
        </div>
      </div>

      <div
        class="admin-sidebar__section {{#if (eq navActive "orders")}}is-open{{/if}}"
        data-accordion-section="orders"
      >
        <button type="button" class="admin-sidebar__section-header" data-accordion-toggle>
          <span>Orders Management</span>
          <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
        </button>
        <div class="admin-sidebar__section-body">
          <a class="admin-sidebar__link" href="/admin/orders">
            <span class="admin-sidebar__link-left">
              <i class="fa-solid fa-receipt admin-sidebar__icon" aria-hidden="true"></i>
              <span>Danh sách đơn</span>
            </span>
          </a>
        </div>
      </div>

      <div
        class="admin-sidebar__section {{#if (eq navActive "users")}}is-open{{/if}}"
        data-accordion-section="users"
      >
        <button type="button" class="admin-sidebar__section-header" data-accordion-toggle>
          <span>Users Management</span>
          <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
        </button>
        <div class="admin-sidebar__section-body">
          <a class="admin-sidebar__link {{#if (eq navActive "users")}}is-active{{/if}}" href="/admin/users">
            <span class="admin-sidebar__link-left">
              <i class="fa-solid fa-users admin-sidebar__icon" aria-hidden="true"></i>
              <span>Danh sách người dùng</span>
            </span>
          </a>
          <a class="admin-sidebar__link" href="/admin/users/new">
            <span class="admin-sidebar__link-left">
              <i class="fa-solid fa-user-plus admin-sidebar__icon" aria-hidden="true"></i>
              <span>Tạo người dùng</span>
            </span>
          </a>
        </div>
      </div>
    </aside>

    <div class="admin-main">
      <section class="admin-form-card">
        {{#if errors}}
          <div class="auth-alert auth-alert--error">
            {{#each errors}}
              <div>{{this}}</div>
            {{/each}}
          </div>
        {{/if}}

        <form action="{{action}}" method="post" class="admin-book-form">
          <div class="form-grid">
            <label>
              <span>Họ tên</span>
              <input type="text" name="fullName" value="{{user.fullName}}" required />
            </label>

            <label>
              <span>Email</span>
              <input type="email" name="email" value="{{user.email}}" required />
            </label>

            <label>
              <span>Mật khẩu {{#if user._id}}(để trống nếu không đổi){{/if}}</span>
              <input type="password" name="password" />
            </label>

            <label>
              <span>Vai trò</span>
              <select name="role">
                <option value="user" {{#if (eq user.role "user")}}selected{{/if}}>Khách</option>
                <option value="admin" {{#if (eq user.role "admin")}}selected{{/if}}>Admin</option>
              </select>
            </label>

            <label>
              <span>Trạng thái</span>
              <select name="isActive">
                <option value="true" {{#if user.isActive}}selected{{/if}}>Hoạt động</option>
                <option value="false" {{#unless user.isActive}}selected{{/unless}}>Khoá</option>
              </select>
            </label>
          </div>

          <div class="admin-book-form__actions">
            <button type="submit" class="btn btn--primary">Lưu</button>
            <a class="btn btn--text" href="/admin/users">Huỷ</a>
          </div>
        </form>
      </section>
    </div>
  </div>
</div>
