<section class="banner-wrapper">
  <div class="container">
    <div class="promo-grid">
      <!-- Banner lớn bên trái -->
      <div class="promo-item promo-item--main promo-slide-wrap">
        <div class="promo-slider js-promo-slider">

          {{!-- img wrapper --}}
          <div class="promo-slider__item">
            <a class="promo-slider__link" href="/gift-page">
              <img src="/img/banner_wrapper.png" alt="Main Banner">
            </a>
          </div>
          <div class="promo-slider__item">
            <a class="promo-slider__link" href="/gift-page">
              <img src="https://cdn1.fahasa.com/media/magentothem/banner7/BinhTayTemplate_KC_Resize_840x320.png"
                alt="Main Banner">
            </a>
          </div>
          <div class="promo-slider__item">
            <a class="promo-slider__link" href="/gift-page">
              <img src="https://cdn1.fahasa.com/media/magentothem/banner7/vongquaymayman_840x320.png" alt="Main Banner">
            </a>
          </div>
          <div class="promo-slider__item">
            <a class="promo-slider__link" href="/gift-page">
              <img src="https://cdn1.fahasa.com/media/magentothem/banner7/TrangUuDai_Resize_840x320.png"
                alt="Main Banner">
            </a>
          </div>
          <div class="promo-slider__item">
            <a class="promo-slider__link" href="/gift-page">
              <img src="https://cdn1.fahasa.com/media/magentothem/banner7/MayoraT12_Resize_840x320.png"
                alt="Main Banner">
            </a>
          </div>
          <div class="promo-slider__item">
            <a class="promo-slider__link" href="/gift-page">
              <img src="https://cdn1.fahasa.com/media/magentothem/banner7/LDP_STABINI_840x320.png" alt="Main Banner">
            </a>
          </div>
          <div class="promo-slider__item">
            <a class="promo-slider__link" href="/gift-page">
              <img src="https://cdn1.fahasa.com/media/magentothem/banner7/DoChoiChoTre_840x320_1.png" alt="Main Banner">
            </a>
          </div>
        </div>
        <button class="promo-slider__nav promo-slider__nav--prev js-promo-prev" type="button" aria-label="Ảnh trước">
          <i class="fa-solid fa-chevron-left"></i>
        </button>
        <button class="promo-slider__nav promo-slider__nav--next js-promo-next" type="button"
          aria-label="Ảnh tiếp theo">
          <i class="fa-solid fa-chevron-right"></i>
        </button>
      </div>

      <!-- Banner nhỏ trên bên phải -->
      <a class="promo-item">
        <img onclick="hehe" src="/img/Ngot_ngao_tung_mung_banh.png" alt="Top Banner">
      </a>

      <!-- Banner nhỏ dưới bên phải -->
      <a class="promo-item">
        <img src="/img/thang12_2025_vpbank.png" alt="Bottom Banner">
      </a>
    </div>
  </div>
</section>
