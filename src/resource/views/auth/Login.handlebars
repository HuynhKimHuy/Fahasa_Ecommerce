<section class="auth-page">
  <div class="auth-card">
    <div class="auth-card__header">
      <p class="auth-card__eyebrow">Tài khoản Fahasa</p>
      <h1>Đăng nhập</h1>
      <p>Truy cập dashboard quản trị hoặc tiếp tục mua sắm với tài khoản của bạn.</p>
    </div>

    {{#if error}}
      <div class="alert-modal alert-modal--error is-visible" role="alert">
        <div class="alert-modal__card">
          <div class="alert-modal__icon">
            <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
          </div>
          <div class="alert-modal__content">
            <p class="alert-modal__title">Đăng nhập không thành công</p>
            <p>{{error}}</p>
          </div>
          <button class="alert-modal__close" type="button" data-close-alert aria-label="Đóng thông báo">
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
          </button>
        </div>
      </div>
    {{/if}}
    {{#if message}}
      <div class="alert-modal alert-modal--{{status}} is-visible" role="alert">
        <div class="alert-modal__card">
          <div class="alert-modal__icon">
            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
          </div>
          <div class="alert-modal__content">
            <p class="alert-modal__title">Thông báo</p>
            <p>{{message}}</p>
          </div>
          <button class="alert-modal__close" type="button" data-close-alert aria-label="Đóng thông báo">
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
          </button>
        </div>
      </div>
    {{/if}}

    <form class="auth-form" action="/auth/login" method="post">
      <input type="hidden" name="redirect" value="{{redirect}}" />
      <label class="auth-form__field">
        <span>Email</span>
        <input type="email" name="email" value="{{email}}" placeholder="ten@domain.com" required inputmode="email" autocomplete="email" />
      </label>
      <label class="auth-form__field">
        <span>Mật khẩu</span>
        <input type="password" name="password" placeholder="••••••••" required />
      </label>
      <button type="submit" class="btn btn--primary auth-form__submit">Đăng nhập</button>
    </form>

    <p class="auth-card__secondary">
      Chưa có tài khoản? <a href="/auth/register">Đăng ký</a>
    </p>
  </div>
</section>
