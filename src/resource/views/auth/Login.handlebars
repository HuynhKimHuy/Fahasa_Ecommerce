<section class="auth-page">
  <div class="auth-card">
    <div class="auth-card__header">
      <p class="auth-card__eyebrow">Tài khoản Fahasa</p>
      <h1>Đăng nhập</h1>
      <p>Truy cập dashboard quản trị hoặc tiếp tục mua sắm với tài khoản của bạn.</p>
    </div>

    {{#if error}}
      <div class="auth-alert auth-alert--error">{{error}}</div>
    {{/if}}
    {{#if message}}
      <div class="auth-alert auth-alert--{{status}}">{{message}}</div>
    {{/if}}

    <form class="auth-form" action="/auth/login" method="post">
      <input type="hidden" name="redirect" value="{{redirect}}" />
      <label class="auth-form__field">
        <span>Email</span>
        <input type="email" name="email" value="{{email}}" placeholder="tên@domain.com" required />
      </label>
      <label class="auth-form__field">
        <span>Mật khẩu</span>
        <input type="password" name="password" placeholder="••••••••" required />
      </label>
      <button type="submit" class="btn btn--primary auth-form__submit">Đăng nhập</button>
    </form>

    <p class="auth-card__secondary">
      Chưa có tài khoản? <a href="/auth/register">Đăng ký</a>
    </p>
  </div>
</section>
